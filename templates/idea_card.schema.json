{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate / idea card (production shape, post-review)",
  "type": "object",
  "required": [
    "title",
    "question",
    "deliverable_sentence"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "deliverable_sentence": {
      "type": "string",
      "minLength": 10
    },
    "X_measurement": {
      "type": [
        "string",
        "object"
      ]
    },
    "suspected_signal": {
      "type": "string"
    },
    "keystone_prerequisite": {
      "type": "string"
    },
    "keystone_status": {
      "type": "string"
    },
    "keystone_evidence": {
      "type": "string"
    },
    "keystone_residual_assumption": {
      "type": "string"
    },
    "dies_like_prior": {
      "type": [
        "string",
        "object",
        "array"
      ]
    },
    "closest_prior_work": {
      "type": [
        "string",
        "array",
        "object"
      ]
    },
    "smallest_decisive_experiment": {
      "type": [
        "string",
        "object"
      ]
    },
    "standing_confounds_addressed": {
      "type": [
        "string",
        "array",
        "object"
      ]
    },
    "use_vs_association": {
      "type": [
        "string",
        "object"
      ]
    },
    "use_vs_association_design": {
      "type": "string"
    },
    "anticipated_negative": {
      "type": [
        "string",
        "object"
      ]
    },
    "unverified_claims": {
      "type": [
        "array",
        "string"
      ]
    },
    "track": {
      "enum": [
        "baseline",
        "wide",
        "fiction"
      ]
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revival_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "kernel_provenance": {
      "type": "string"
    },
    "design_template": {
      "type": "string"
    },
    "rung": {},
    "search_mode": {
      "type": "string"
    },
    "priority_score": {
      "type": "number"
    },
    "priority_arithmetic": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "why": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
